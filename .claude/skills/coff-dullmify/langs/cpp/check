#!/bin/sh
# Checks a C++ workflow: syntax, then a deny list of APIs that bypass the
# runtime. Prints every problem and exits non-zero if there is any.
#   sh check <workflow.cpp>
dir=$(cd "$(dirname "$0")" && pwd)
f=$1
[ -n "$f" ] && [ -f "$f" ] || { echo "usage: check <workflow.cpp>" >&2; exit 2; }
status=0
problem() { echo "$f: $1"; status=1; }

${CXX:-c++} -std=c++17 -fsyntax-only -I"$dir" "$f" || problem "syntax check with ${CXX:-c++} failed (see the compiler output above, if any)"

# Strip comments and (with keep=0) string and character literal contents.
# Newlines are preserved so line numbers stay right.
strip() {
  awk -v keep="$1" '
  BEGIN { st = 0 }
  {
    line = $0; out = ""; n = length(line); i = 1; prev = ""
    while (i <= n) {
      c = substr(line, i, 1); c2 = substr(line, i, 2)
      if (st == 0) {
        if (c2 == "//") break
        if (c2 == "/*") { st = 1; i += 2; continue }
        if (c == "\"") { st = 2; out = out c; i++; continue }
        if (c == "\047" && prev ~ /[0-9]/ && substr(line, i + 1, 1) ~ /[0-9a-fA-F]/) { prev = c; i++; continue }
        if (c == "\047") { st = 3; out = out c; i++; continue }
        out = out c; prev = c; i++
      } else if (st == 1) {
        if (c2 == "*/") { st = 0; i += 2 } else i++
      } else if (st == 2) {
        if (c == "\\") { if (keep) out = out c2; i += 2; continue }
        if (c == "\"") { st = 0; out = out c; i++; continue }
        if (keep) out = out c
        i++
      } else {
        if (c == "\\") { i += 2; continue }
        if (c == "\047") { st = 0; out = out c; i++; continue }
        i++
      }
    }
    if (st == 2 || st == 3) st = 0
    print out
  }' "$f"
}

code=$(strip 0)
with_strings=$(strip 1)

# Raw string literals would defeat the simple string stripping above.
m=$(printf '%s\n' "$with_strings" | grep -nE '(^|[^[:alnum:]_])(u8|u|U|L)?R"') && { problem "raw string literals are not allowed"; echo "$m" | sed 's/^/  line /'; }

deny() { # pattern, message
  m=$(printf '%s\n' "$code" | grep -nE "$1") && { problem "$2"; echo "$m" | sed 's/^/  line /'; }
}

# Preprocessor: only #include of the allow list, or "runtime.hpp".
allowed='algorithm|any|array|bitset|cctype|charconv|climits|cmath|cstddef|cstdint|cstring|cstdlib|deque|functional|initializer_list|iomanip|iterator|limits|list|map|memory|numeric|optional|queue|regex|set|sstream|stack|stdexcept|string|string_view|tuple|type_traits|unordered_map|unordered_set|utility|variant|vector'
m=$(printf '%s\n' "$with_strings" | grep -nE '^[[:space:]]*(#|%:)' | grep -vE "^[0-9]+:[[:space:]]*#[[:space:]]*include[[:space:]]*(<($allowed)>|\"runtime.hpp\")[[:space:]]*$") \
  && { problem "only #include of these headers is allowed: $(printf '%s' "$allowed" | tr '|' ' ') \"runtime.hpp\""; echo "$m" | sed 's/^/  line /'; }
m=$(printf '%s\n' "$with_strings" | grep -nE 'extern[[:space:]]*"C') && { problem 'extern "C" declarations are not allowed'; echo "$m" | sed 's/^/  line /'; }

deny 'catch[[:space:]]*\([[:space:]]*\.\.\.[[:space:]]*\)' \
  'catch (...) would swallow the runtime signal; catch std::exception (or a subclass) instead'
deny '(^|[^[:alnum:]_])(FILE|stdin|stdout|stderr|environ|va_list)([^[:alnum:]_]|$)' \
  'C stdio or environment object outside the runtime'
deny '(^|[^[:alnum:]_.>])(system|popen|pclose|fopen|freopen|fdopen|fclose|fread|fwrite|fgets|fgetc|fputs|fputc|fprintf|printf|vprintf|vfprintf|sprintf|snprintf|puts|putchar|getchar|scanf|fscanf|sscanf|perror|tmpfile|tmpnam|remove|rename|open|openat|creat|close|read|write|pread|pwrite|dup|dup2|pipe|fork|vfork|execl|execlp|execle|execv|execvp|execvpe|execve|wait|waitpid|kill|raise|signal|sigaction|alarm|sleep|usleep|nanosleep|getenv|setenv|putenv|unsetenv|clearenv|time|clock|clock_gettime|localtime|gmtime|strftime|difftime|rand|srand|random|srandom|rand_r|drand48|lrand48|mrand48|exit|_exit|_Exit|quick_exit|abort|atexit|at_quick_exit|terminate|chdir|mkdir|rmdir|unlink|opendir|readdir|scandir|closedir|stat|fstat|lstat|access|chmod|chown|syscall|fcntl|poll|getpid|getppid|getuid|geteuid|getgid|gethostname|getcwd|realpath|readlink|symlink|link|truncate|ftruncate|fsync|mkstemp|mkdtemp)([^[:alnum:]_]|$)' \
  'C or POSIX function outside the runtime (stdio, process, time, random, exit, environment, filesystem); also rejected as a name, since a pointer to it bypasses the call check'
deny '(^|[^[:alnum:]_])(asm|__asm__|__asm)([^[:alnum:]_]|$)' \
  'inline assembly'
deny '(^|[^[:alnum:]_])dullmify::detail([^[:alnum:]_]|$)' \
  'runtime internals'

exit $status
