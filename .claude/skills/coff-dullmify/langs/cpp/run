#!/bin/sh

# skill の配置場所と run の開始場所を、呼び出しごとに確定する。
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || {
  echo "起動スクリプトの場所を解決できません" >&2
  exit 2
}

start_output() {
  printf '{"run":"%s","write":"%s/args"}\n' "$1" "$1"
}

workflow_key() {
  cat "$script_dir/workflow.cpp" "$script_dir/runtime.hpp" "$script_dir/json.hpp" | cksum
}

fail_changed() {
  rm -rf -- "$1"
  printf '%s\n' '{"failed":"workflow またはランタイムが開始後に変わりました"}'
}

case "${1-}" in
  start)
    [ "$#" -eq 1 ] || { echo "start に引数は指定できません" >&2; exit 2; }
    temporary_root=$(CDPATH= cd -- "${TMPDIR:-/tmp}" && pwd -P) || {
      echo "一時ディレクトリの場所を解決できません" >&2
      exit 2
    }
    run_dir=$(mktemp -d "$temporary_root/coff-dullmify-run.XXXXXX") || {
      echo "run ディレクトリを作れません" >&2
      exit 2
    }
    : > "$run_dir/.dullmify-run" || { rm -rf -- "$run_dir"; echo "run の目印を作れません" >&2; exit 2; }
    pwd -P > "$run_dir/cwd" || { rm -rf -- "$run_dir"; echo "作業ディレクトリを記録できません" >&2; exit 2; }
    workflow_key > "$run_dir/workflow-key" || { rm -rf -- "$run_dir"; echo "workflow のキーを記録できません" >&2; exit 2; }
    start_output "$run_dir"
    ;;
  continue)
    [ "$#" -eq 2 ] || { echo "continue には run ディレクトリを一つ指定してください" >&2; exit 2; }
    run_dir=$2
    [ -d "$run_dir" ] && [ -f "$run_dir/.dullmify-run" ] || {
      echo "dullmify が作った run ディレクトリではありません" >&2
      exit 2
    }
    if [ ! -f "$run_dir/args" ]; then
      start_output "$run_dir"
      exit 0
    fi
    current_key=$(workflow_key) || current_key=
    saved_key=$(cat "$run_dir/workflow-key" 2>/dev/null) || saved_key=
    if [ -z "$current_key" ] || [ "$current_key" != "$saved_key" ]; then
      fail_changed "$run_dir"
      exit 0
    fi

    temporary_root=$(CDPATH= cd -- "${TMPDIR:-/tmp}" && pwd -P) || {
      echo "一時ディレクトリの場所を解決できません" >&2
      exit 2
    }
    uid=$(id -u) || { echo "利用者 ID を取得できません" >&2; exit 2; }
    user_dir=$temporary_root/coff-dullmify-$uid
    if [ ! -e "$user_dir" ]; then
      (umask 077 && mkdir "$user_dir") || { echo "利用者用キャッシュを作れません" >&2; exit 2; }
    fi
    # 自分が所有する（シンボリックリンクでない）ディレクトリなら権限を 700 に直し、他人のものなら使わない。
    if [ -L "$user_dir" ] || ! find "$user_dir" -prune -type d -user "$uid" 2>/dev/null | grep -Fqx "$user_dir" || ! chmod 700 "$user_dir"; then
      echo "利用者用キャッシュの所有者が自分ではありません: $user_dir" >&2
      exit 2
    fi
    cache_dir=$user_dir/cpp-cache
    if [ ! -e "$cache_dir" ]; then
      (umask 077 && mkdir "$cache_dir") || { echo "C++ キャッシュを作れません" >&2; exit 2; }
    fi
    if [ -L "$cache_dir" ] || ! find "$cache_dir" -prune -type d -user "$uid" 2>/dev/null | grep -Fqx "$cache_dir" || ! chmod 700 "$cache_dir"; then
      echo "C++ キャッシュの所有者が自分ではありません: $cache_dir" >&2
      exit 2
    fi
    set -- $current_key
    binary=$cache_dir/workflow-$1-$2
    if [ ! -x "$binary" ]; then
      temporary_binary=$(mktemp "$cache_dir/.workflow.XXXXXX") || {
        echo "一時バイナリを作れません" >&2
        exit 2
      }
      if ! "${CXX:-c++}" -std=c++17 -I"$script_dir" "$script_dir/workflow.cpp" -o "$temporary_binary"; then
        rm -f -- "$temporary_binary"
        rm -rf -- "$run_dir"
        printf '%s\n' '{"failed":"C++ workflow をビルドできませんでした"}'
        exit 0
      fi
      chmod 700 "$temporary_binary" && mv -f -- "$temporary_binary" "$binary" || {
        rm -f -- "$temporary_binary"
        echo "C++ バイナリをキャッシュできません" >&2
        exit 2
      }
    fi
    "$binary" "$run_dir"
    ;;
  *)
    echo "使い方: sh scripts/run start | sh scripts/run continue <run>" >&2
    exit 2
    ;;
esac
