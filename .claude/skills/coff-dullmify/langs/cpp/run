#!/bin/sh
# Launcher for a dullmified skill (C++). Builds workflow.cpp on first use and
# caches the binary under ${TMPDIR:-/tmp}, keyed by the source contents.
#   sh <skill dir>/scripts/run start
#   sh <skill dir>/scripts/run continue <run>
dir=$(cd "$(dirname "$0")" && pwd)
key=$(cat "$dir/workflow.cpp" "$dir/runtime.hpp" | cksum | tr ' ' '-')
cache="${TMPDIR:-/tmp}/dullmify-cpp-cache-$(id -u)"
bin="$cache/workflow-$key"
if [ ! -d "$cache" ]; then
  mkdir -m 700 "$cache" || { echo "cannot create build cache $cache" >&2; exit 2; }
fi
[ -O "$cache" ] || { echo "build cache $cache is not owned by the current user" >&2; exit 2; }
if [ ! -x "$bin" ]; then
  tmp=$(mktemp "$cache/build.XXXXXX") || { echo "cannot create a build file in $cache" >&2; exit 2; }
  if ! log=$(${CXX:-c++} -std=c++17 -O1 -I"$dir" -o "$tmp" "$dir/workflow.cpp" 2>&1); then
    rm -f "$tmp"
    esc=$(printf '%s' "$log" | awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); if (NR > 1) printf "\\n"; printf "%s", $0 }')
    printf '{"failed":"C++ build failed: %s"}\n' "$esc"
    [ "$1" = continue ] && [ -f "$2/.dullmify-run" ] && rm -rf "$2"
    exit 0
  fi
  mv -f "$tmp" "$bin"
fi
exec "$bin" "$key" "$@"
